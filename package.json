{
  "name": "lk-newsroom",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "LK Newsroom with Supabase CMS and live RSS/API aggregation",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "worker:once": "tsx worker/runOnce.ts",
    "typecheck": "tsc --noEmit",
    "lint:html": "npx html-validate '**/*.html'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
