# Server-only secrets. Never copy these values into js/config.js or the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
PORT=5173
PUBLIC_ORIGIN=http://localhost:5173
SYNC_ON_BOOT=true
TZ=Africa/Accra
CRON_SECRET=replace-with-a-long-random-secret-before-deploying
# Turn this off when a host-level cron service runs `npm run worker:once` instead.
ENABLE_NODE_CRON=true
DOWNLOAD_FEED_IMAGES=false
SOURCE_FAILURE_THRESHOLD=3
ADMIN_ALERT_WEBHOOK=

# Official publisher / authorised aggregator APIs. Put the real keys in .env only.
GUARDIAN_API_KEY=
NEWS_API_KEY=
NEWS_API_COUNTRY=us
NEWS_API_CATEGORY=general
NEWS_API_SPORTS_QUERY=football OR soccer OR premier league OR champions league OR Black Stars OR CAF OR FIFA
BBC_SPORT_RSS_URL=https://feeds.bbci.co.uk/sport/football/rss.xml
X_BEARER_TOKEN=
FABRIZIO_X_HANDLE=FabrizioRomano
# Optional. If omitted, the provider resolves the official X user ID from the handle.
FABRIZIO_X_USER_ID=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
AUTO_FILL_MISSING_IMAGES=false
AUTO_IMAGE_BACKFILL_LIMIT=6

# Social Media Automation. Keep every token server-side (Railway Variables only).
# Generate SOCIAL_TOKEN_ENCRYPTION_KEY with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
THREADS_APP_ID=
THREADS_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
# Token-backed connections (especially Telegram) use the variable NAME in Admin > Social Media.
TELEGRAM_BOT_TOKEN=
NYT_API_KEY=
REUTERS_RSS_URL=
# Publisher-provided RSS feeds enabled by default: JoyNews, Citi Newsroom, GhanaWeb,
# 3News / TV3 Ghana, Adom Online, Africanews and News24. Set these only to override an endpoint.
JOYNEWS_RSS_URL=
CITI_NEWSROOM_RSS_URL=
GHANAWEB_RSS_URL=
TV3_GHANA_RSS_URL=
ADOM_ONLINE_RSS_URL=
AFRICANEWS_RSS_URL=
NEWS24_RSS_URL=
# Optional channel overrides for the official publisher YouTube feeds used by Latest Videos.
# No YouTube API key is required for these publisher-provided Atom feeds.
BBC_NEWS_YOUTUBE_CHANNEL_ID=
REUTERS_YOUTUBE_CHANNEL_ID=
ALJAZEERA_YOUTUBE_CHANNEL_ID=
SKY_NEWS_YOUTUBE_CHANNEL_ID=
# Add only permitted publisher RSS/API endpoints. Unconfigured licensed sources remain disabled in Admin.
