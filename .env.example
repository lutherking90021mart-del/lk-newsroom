# Server-only secrets. Never copy these values into js/config.js or the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
PORT=5173
PUBLIC_ORIGIN=http://localhost:5173
SYNC_ON_BOOT=true
TZ=Africa/Accra
CRON_SECRET=replace-with-a-long-random-secret-before-deploying
# Turn this off when a host-level cron service runs `npm run worker:once` instead.
ENABLE_NODE_CRON=true
DOWNLOAD_FEED_IMAGES=false

# Optional Cloudflare R2 public media storage. When all values are set, new media uploads
# and generated social graphics use R2; existing Supabase URLs continue to work.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lk-newsroom-media
# Public bucket custom domain or r2.dev base URL, without a trailing slash.
R2_PUBLIC_BASE_URL=
# Optional separate private bucket/token for sensitive CSV export archives. Do not enable public access for this bucket.
R2_PRIVATE_BUCKET_NAME=lk-newsroom-private-media
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
SOURCE_FAILURE_THRESHOLD=3
ADMIN_ALERT_WEBHOOK=

# Football data API. Configure SPORTSAPI_KEY in Render Environment Variables only; never in frontend JavaScript.
SPORTSAPI_KEY=
# Legacy API-Football key (not used by the current SportsAPI integration).
API_FOOTBALL_KEY=

# Official publisher / authorised aggregator APIs. Put the real keys in .env only.
GUARDIAN_API_KEY=
NEWS_API_KEY=
NEWS_API_COUNTRY=us
NEWS_API_CATEGORY=general
NEWS_API_SPORTS_QUERY=football OR soccer OR premier league OR champions league OR Black Stars OR CAF OR FIFA
BBC_SPORT_RSS_URL=https://feeds.bbci.co.uk/sport/football/rss.xml
X_BEARER_TOKEN=
FABRIZIO_X_HANDLE=FabrizioRomano
# Optional. If omitted, the provider resolves the official X user ID from the handle.
FABRIZIO_X_USER_ID=
# Optional stock-photo fallback for articles whose feeds provide no image.
PIXABAY_API_KEY=
AUTO_FILL_MISSING_IMAGES=false
AUTO_IMAGE_BACKFILL_LIMIT=6

# Social Media Automation. Keep every token server-side (Render environment variables only).
# Generate SOCIAL_TOKEN_ENCRYPTION_KEY with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
ADMIN_ALERT_WEBHOOK=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
THREADS_APP_ID=
THREADS_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
# Token-backed connections (especially Telegram) use the variable NAME in Admin > Social Media.
TELEGRAM_BOT_TOKEN=
# Optional payment providers. Add these as server environment variables only.
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NYT_API_KEY=
REUTERS_RSS_URL=
# Publisher-provided RSS feeds enabled by default: JoyNews, Citi Newsroom, GhanaWeb,
# 3News / TV3 Ghana, Adom Online, Africanews and News24. Set these only to override an endpoint.
JOYNEWS_RSS_URL=
CITI_NEWSROOM_RSS_URL=
GHANAWEB_RSS_URL=
TV3_GHANA_RSS_URL=
ADOM_ONLINE_RSS_URL=
AFRICANEWS_RSS_URL=
NEWS24_RSS_URL=
# Optional channel overrides for the official publisher YouTube feeds used by Latest Videos.
# No YouTube API key is required for these publisher-provided Atom feeds.
BBC_NEWS_YOUTUBE_CHANNEL_ID=
REUTERS_YOUTUBE_CHANNEL_ID=
ALJAZEERA_YOUTUBE_CHANNEL_ID=
SKY_NEWS_YOUTUBE_CHANNEL_ID=
# Add only permitted publisher RSS/API endpoints. Unconfigured licensed sources remain disabled in Admin.
# Optional official publisher YouTube feeds for more video categories.
# Set a channel ID to enable each additional source; use the publisher's official channel ID.
ESPN_SPORTS_YOUTUBE_CHANNEL_ID=
FIFA_YOUTUBE_CHANNEL_ID=
SKY_SPORTS_YOUTUBE_CHANNEL_ID=
BBC_ENTERTAINMENT_YOUTUBE_CHANNEL_ID=
VARIETY_YOUTUBE_CHANNEL_ID=
BLOOMBERG_YOUTUBE_CHANNEL_ID=
CNBC_YOUTUBE_CHANNEL_ID=
FRANCE24_YOUTUBE_CHANNEL_ID=
AP_YOUTUBE_CHANNEL_ID=

# BBC-style reader notifications. These stay in server variables; browser keys are safe to expose only through the public endpoint.
DAILY_BRIEF_HOUR=7
RESEND_API_KEY=
EMAIL_FROM=LK Newsroom <news@your-domain.com>
VAPID_SUBJECT=mailto:news@your-domain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional urgent SMS notifications via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
